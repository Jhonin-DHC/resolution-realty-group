# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/resolution-realty-group

# Auth
AUTH_SECRET=replace-with-long-random-string
ADMIN_EMAIL=admin@resolutionrealtygroup.com
ADMIN_PASSWORD=replace-with-strong-password

# Site (production uses https://www.resolutionrealtygroup.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 image uploads (new admin uploads only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rrg-media
R2_PUBLIC_BASE_URL=

# SMTP email (inquiry alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="Resolution Realty Group <concierge@resolutionrealtygroup.com>"
SMTP_USER=
SMTP_PASS=
INQUIRY_NOTIFY_EMAILS=concierge@resolutionrealtygroup.com
